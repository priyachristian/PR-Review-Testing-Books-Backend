<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title><%= title || 'ABSS Account' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
            line-height: 1.6;
            color: #111827;
            background-color: #f3f4f6;
            padding: 0;
            margin: 0;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        .email-container {
            max-width: 100%;
            margin: 0 auto;
            background-color: #f3f4f6;
            border-radius: 0;
            overflow: hidden;
        }

        .email-header {
            background-color: #f3f4f6;
            padding: 48px 40px 32px 40px;
            text-align: center;
        }

        .logo-container {
            margin: 0 auto;
        }

        .logo {
            max-width: 160px;
            height: auto;
            display: inline-block;
        }

        .email-body {
            background-color: #ffffff;
            padding: 48px 56px;
            max-width: 680px;
            margin: 0 auto;
            border-radius: 8px;
        }

        .email-body h1 {
            font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            font-size: 24px;
            font-weight: 600;
            line-height: 1.3;
            color: #111827;
            margin-bottom: 24px;
            text-align: center;
        }

        .email-body h2,
        .email-body h3,
        .email-body h4 {
            font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            font-weight: 600;
            line-height: 1.3;
            color: #111827;
        }

        .email-footer {
            background-color: #f3f4f6;
            padding: 40px;
            text-align: center;
        }

        .email-footer p {
            font-size: 14px;
            color: #6b7280;
            margin-bottom: 12px;
        }

        .email-footer a {
            color: #111827;
            text-decoration: none;
            font-weight: 500;
        }

        .email-footer a:hover {
            text-decoration: underline;
        }

        .button {
            display: inline-block;
            padding: 14px 40px;
            background-color: #111827;
            color: #ffffff !important;
            text-decoration: none;
            border-radius: 4px;
            font-weight: 600;
            font-size: 15px;
            text-align: center;
            transition: all 0.2s ease-in-out;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        .button:hover {
            background-color: #374151;
        }

        .button-secondary {
            display: inline-block;
            padding: 14px 40px;
            background-color: #ffffff;
            color: #111827 !important;
            text-decoration: none;
            border: 2px solid #d1d5db;
            border-radius: 4px;
            font-weight: 600;
            font-size: 15px;
            text-align: center;
            transition: all 0.2s ease-in-out;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        .button-secondary:hover {
            background-color: #f9fafb;
            border-color: #111827;
        }

        .otp-box {
            background-color: #f9fafb;
            border: none;
            border-radius: 4px;
            padding: 32px 24px;
            text-align: center;
            margin: 32px 0;
        }

        .otp-code {
            font-size: 42px;
            font-weight: 700;
            color: #111827;
            letter-spacing: 12px;
            font-family: 'Space Grotesk', 'Courier New', monospace;
            margin: 16px 0;
        }

        .divider {
            height: 1px;
            background-color: #e5e7eb;
            margin: 30px 0;
        }

        .info-box {
            background-color: #f9fafb;
            border-left: 3px solid #6b7280;
            padding: 16px 20px;
            margin: 24px 0;
            border-radius: 4px;
        }

        .warning-box {
            background-color: #fef2f2;
            border-left: 3px solid #dc2626;
            padding: 16px 20px;
            margin: 24px 0;
            border-radius: 4px;
        }

        .success-box {
            background-color: #f0fdf4;
            border-left: 3px solid #16a34a;
            padding: 16px 20px;
            margin: 24px 0;
            border-radius: 4px;
        }

        .link-box {
            background-color: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 4px;
            padding: 16px 20px;
            margin: 24px 0;
            word-break: break-all;
        }

        .link-box a {
            color: #111827;
            text-decoration: none;
            font-size: 14px;
        }

        @media only screen and (max-width: 600px) {
            .email-header {
                padding: 40px 20px 24px 20px;
            }

            .logo {
                max-width: 140px;
            }

            .email-body {
                padding: 40px 28px;
                margin: 0 16px;
                border-radius: 6px;
            }

            .email-body h1 {
                font-size: 22px;
                margin-bottom: 20px;
            }

            .email-footer {
                padding: 32px 20px;
            }

            .otp-code {
                font-size: 32px;
                letter-spacing: 8px;
            }

            .button {
                padding: 14px 32px;
                font-size: 15px;
                display: inline-block;
            }
        }
    </style>
</head>
<body>
    <div class="email-container">
        <!-- Header -->
        <div class="email-header">
            <div class="logo-container">
                <img src="<%= typeof logoUrl !== 'undefined' ? logoUrl : 'cid:abss-logo' %>" alt="ABSS" class="logo">
            </div>
        </div>

        <!-- Body Content -->
        <div class="email-body">
            <%- body %>
        </div>

        <!-- Footer -->
        <div class="email-footer">
            <p>&copy; <%= new Date().getFullYear() %> ABSS. All rights reserved.</p>
            <p>
                Need help? <a href="mailto:support@abss.ai">Contact Support</a>
            </p>
            <p style="font-size: 12px; color: #9ca3af; margin-top: 15px;">
                This is an automated email. Please do not reply to this message.
            </p>
        </div>
    </div>
</body>
</html>

